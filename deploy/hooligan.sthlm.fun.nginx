# THE LAST HOOLIGAN (static game, deployed by scripts/deploy.sh from the hooligan repo)

# code and assets with ?v=... in the URL (a release / a content hash, written by scripts/release.mjs) never change:
# keep them forever. Everything else (index.html, index files, unhashed images) is revalidated on every load (cheap
# 304s), so a deploy shows up on the next reload instead of after a stale cached copy has been used.
map $arg_v $hooligan_asset_cc {
    ""      "no-cache";
    default "public, max-age=31536000, immutable";
}

server {
    server_name hooligan.sthlm.fun;

    root /var/www/hooligan;
    index index.html;
    charset utf-8;

    location /.well-known/acme-challenge/ { root /var/www/html; }

    # basic hardening: no MIME sniffing, no framing by other sites, no referrer leaks off-site
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_vary on;
    gzip_types application/javascript text/javascript application/json text/css image/svg+xml model/gltf-binary application/octet-stream;


    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
    # code: release builds import every module as ?v=<release> (scripts/release.mjs): kept forever, a deploy brings
    # new URLs. Without ?v (a dev copy) it's revalidated on every load.
    location /src/ {
        try_files $uri =404;
        add_header Cache-Control $hooligan_asset_cc;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
    # assets: hashed URLs forever, the rest revalidated (see the map above)
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control $hooligan_asset_cc;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/hooligan.sthlm.fun/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/hooligan.sthlm.fun/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = hooligan.sthlm.fun) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name hooligan.sthlm.fun;
    return 404; # managed by Certbot


}